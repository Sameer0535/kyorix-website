# ====================================================================
# KYORIX SPORT TECHNOLOGY - ENVIRONMENT CONFIGURATION
# ====================================================================

# --------------------------------------------------------------------
# 1. MongoDB Cloud Database Connection (Required for Live CMS Sync)
# --------------------------------------------------------------------
# Get this from MongoDB Atlas (Free M0 Cluster):
# Connect -> Drivers -> Node.js -> Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/kyorix?retryWrites=true&w=majority

# --------------------------------------------------------------------
# 2. Inquiry Notifications & Email Dispatch (Optional)
# --------------------------------------------------------------------
# Default email receiving inquiries: kyorixofficial@gmail.com
NOTIFICATION_EMAIL=kyorixofficial@gmail.com

# Optional SMTP Settings (Gmail or Corporate SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=kyorixofficial@gmail.com
SMTP_PASS=your-app-password-here

# Optional Web3Forms Access Key
# WEB3FORMS_KEY=your-web3forms-key-here
